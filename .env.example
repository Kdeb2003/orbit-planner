VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Optional. "false" hides the registration form (cosmetic only: to really close
# registration, turn off "Allow new users to sign up" in the Supabase dashboard).
# VITE_ENABLE_SIGNUP=false

# Optional. "true" adds Supabase Realtime on top of the focus/poll refresh. Needs the three tables in the
# supabase_realtime publication (Dashboard > Database > Publications). Leave off unless you set that up.
# VITE_ENABLE_REALTIME=true

# Optional. "true" enables "Confirm & Save to Calendar" in the timetable importer. Leave OFF for the hosted project until
# the provenance migration (supabase/migrations/20261015120000_event_imports.sql) has been applied there; use it with the local Docker stack.
# VITE_ENABLE_TIMETABLE_SAVE=true

# Optional. "true" enables the (cloud-only) Courses feature; off by default in source. The production deploy workflow sets it
# to 'true' (the courses migration is applied to the hosted project and verified). For local work use the local Docker stack.
# VITE_ENABLE_PLANNER_COURSES=true
